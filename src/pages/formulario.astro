---
// Se mantiene la URL para links viejos y campañas: muestra el mismo flujo de la home.
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Nav from '../components/Nav.astro';
import LeadFlow from '../components/LeadFlow.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Ver si califico — SIMO" description="Elegí tu moto y fijate si calificás para el leasing de SIMO en 1 minuto.">
  <TopBar />
  <Nav />

  <section class="section-dark lf-page">
    <div class="section-inner">
      <div class="section-head">
        <h2>Tu moto para trabajar, <strong>en 1 minuto</strong></h2>
        <p class="section-sub">Elegí el modelo, contestá 2 preguntas y un asesor te confirma si calificás.</p>
      </div>
      <LeadFlow />
    </div>
  </section>

  <Footer />
</Layout>
