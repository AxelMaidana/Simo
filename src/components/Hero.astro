---
import LeadFlow from './LeadFlow.astro';
import { CUOTA_SEMANAL, pesos } from '../data/planes';
---
<section class="hero" id="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <h1><span class="intro-item" style="--i:0">Tu moto para trabajar,</span><br /><strong class="intro-item" style="--i:1">desde {pesos(CUOTA_SEMANAL)} por semana.</strong></h1>
      <p class="lead intro-item" style="--i:2">La moto se paga sola: salís a trabajar con ella desde el primer día, pagás una cuota fija por semana y al final es 100% tuya. Sin bancos, sin vueltas.</p>
      <div class="intro-item" style="--i:2">
      <ul class="incluye incluye-dark">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3z"/><path d="m9 12 2 2 4-4"/></svg>Seguro</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>GPS</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4 2.5-2.5z"/></svg>Mantenimiento programado</li>
      </ul>
      </div>
      <div class="hero-cta intro-item" style="--i:3">
        <a href="#califica" class="btn btn-lg" data-scroll-offset="-100">Ver si califico
          <svg class="arr" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.06 11.57h13.76M13.5 5l6.5 6.5-6.5 6.5"/></svg>
        </a>
        <a href="https://wa.me/000000000?text=Hola%20SIMO,%20quiero%20mi%20moto" class="btn-link" target="_blank" rel="noopener">Prefiero hablar por WhatsApp
          <svg class="arr" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.06 11.57h13.76M13.5 5l6.5 6.5-6.5 6.5"/></svg>
        </a>
      </div>
      <p class="hero-micro intro-item" style="--i:3">1 minuto · Sin compromiso · Respuesta por WhatsApp</p>
      <p class="hero-for intro-item" style="--i:4">Para delivery, técnicos, comerciantes, emprendedores e independientes de Chaco, Corrientes, Formosa y Misiones.</p>
    </div>

    <div class="intro-item hero-flow" style="--i:4">
      <LeadFlow />
    </div>
  </div>
</section>
